root_variant0_tool_value ::= "\"calculator\""
root_variant0_expression_value ::= "\"" ([^"\\\n] | "\\" ["\\/bfnrt])* "\""
root_variant0 ::= "{" ws "\"tool\"" ws ":" ws root_variant0_tool_value ws "," ws "\"expression\"" ws ":" ws root_variant0_expression_value ws "}"
root_variant1_tool_value ::= "\"weather\""
root_variant1_location_value ::= "\"" ([^"\\\n] | "\\" ["\\/bfnrt])* "\""
root_variant1 ::= "{" ws "\"tool\"" ws ":" ws root_variant1_tool_value ws "," ws "\"location\"" ws ":" ws root_variant1_location_value ws "}"
root ::= root_variant0 | root_variant1
ws ::= [ \t\n]*
