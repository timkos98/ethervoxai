root_user_value_name_value ::= "\"" ([^"\\\n] | "\\" ["\\/bfnrt])* "\""
root_user_value_age_value ::= ("-")? [0-9]+
root_user_value_address_value_street_value ::= "\"" ([^"\\\n] | "\\" ["\\/bfnrt])* "\""
root_user_value_address_value_city_value ::= "\"" ([^"\\\n] | "\\" ["\\/bfnrt])* "\""
root_user_value_address_value ::= "{" ws "\"street\"" ws ":" ws root_user_value_address_value_street_value ws "," ws "\"city\"" ws ":" ws root_user_value_address_value_city_value ws "}"
root_user_value ::= "{" ws "\"name\"" ws ":" ws root_user_value_name_value ws "," ws "\"age\"" ws ":" ws root_user_value_age_value ws "," ws "\"address\"" ws ":" ws root_user_value_address_value ws "}"
root_timestamp_value ::= ("-")? [0-9]+
root ::= "{" ws "\"user\"" ws ":" ws root_user_value ws "," ws "\"timestamp\"" ws ":" ws root_timestamp_value ws "}"
ws ::= [ \t\n]*
